<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="4dp"
    android:layout_marginTop="8dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="8dp"
    card_view:cardBackgroundColor="@color/card"
    card_view:cardCornerRadius="8dp"
    card_view:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/machineIcon"
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:background="@drawable/icon_circle_bg"
                android:contentDescription="Machine icon"
                android:padding="9dp"
                android:src="@drawable/ic_tractor" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/machineName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Machine"
                    android:textColor="@color/textPrimary"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/machineOwner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Owner: Local owner"
                    android:textColor="@color/textSecondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/machinePrice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/price_badge_bg"
                android:paddingStart="10dp"
                android:paddingTop="6dp"
                android:paddingEnd="10dp"
                android:paddingBottom="6dp"
                android:text="Rs 500/hr"
                android:textColor="@color/soil"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/machineMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="2dp"
            android:text="Pickup: Farm depot | 2.5 km away | 10 km delivery"
            android:textColor="@color/textSecondary"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/machineStatus"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/status_chip_bg"
                android:gravity="center"
                android:minWidth="92dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="Available"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/machineCondition"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/input_bg"
                android:gravity="center"
                android:text="4.5 condition"
                android:textColor="@color/textPrimary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/bookBtn"
                android:layout_width="92dp"
                android:layout_height="42dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_primary"
                android:backgroundTint="@color/primary"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Book"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                card_view:backgroundTint="@color/primary" />
        </LinearLayout>
    </LinearLayout>

</androidx.cardview.widget.CardView>
